// FilmScan_MaskCrosstalk (optional, between Node 1 FilmScan_Density_In and the print/positive node)
// Input and output: Cineon-style density codes as code/full_code (what FilmScan_Density_In outputs).
// D = (code - dmin_code) * dens_step. Mask compensation subtracts a per-channel base density,
// then the 3x3 crosstalk matrix is mixed in density space: M_s = (1 - strength) * I + strength * M.
// Defaults (mask off, identity matrix, strength 0) return the input unchanged.
// If FilmScan_Density_In already divides by the measured film base, the mask is already removed:
// leave mask compensation OFF there. Use it only for input whose film base is not at dmin_code.

// ===== MATRIX PRESETS =====
// Prototype values from colorsci (Kodak 5219 dye curves x approximate X-T3 sensitivities, flat white light).
// Like the film base presets, choosing a preset overrides the nine matrix sliders. Choose Custom to use them again.
DEFINE_UI_PARAMS(mat_preset, Crosstalk matrix preset, DCTLUI_COMBO_BOX, 0, {M_CUSTOM, M_DEFAULT, M_UNMASKED, M_KODAK1, M_KODAK2, M_KODAK3, M_KODAK4}, {Custom - use sliders below, Vision3 5219 mask-aware - suggest 50 pct, Vision3 5219 unmasked - strong, Ektar 100 - datasheet spectral, Portra 400 - datasheet spectral, UltraMax 400 - datasheet spectral, Gold 200 - datasheet spectral})
DEFINE_UI_PARAMS(mask_on, Orange mask compensation, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(bd_r, Base density R, DCTLUI_SLIDER_FLOAT, 0.0, -0.5, 3.0, 0.0001)
DEFINE_UI_PARAMS(bd_g, Base density G, DCTLUI_SLIDER_FLOAT, 0.0, -0.5, 3.0, 0.0001)
DEFINE_UI_PARAMS(bd_b, Base density B, DCTLUI_SLIDER_FLOAT, 0.0, -0.5, 3.0, 0.0001)
DEFINE_UI_PARAMS(m00, Matrix R from R, DCTLUI_SLIDER_FLOAT, 1.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(m01, Matrix R from G, DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(m02, Matrix R from B, DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(m10, Matrix G from R, DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(m11, Matrix G from G, DCTLUI_SLIDER_FLOAT, 1.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(m12, Matrix G from B, DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(m20, Matrix B from R, DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(m21, Matrix B from G, DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(m22, Matrix B from B, DCTLUI_SLIDER_FLOAT, 1.0, -3.0, 3.0, 0.0001)
DEFINE_UI_PARAMS(strength, Crosstalk strength, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(dmin_code, Film base code, DCTLUI_SLIDER_FLOAT, 95.0, 0.0, 300.0, 0.5)
DEFINE_UI_PARAMS(dens_step, Density per code, DCTLUI_SLIDER_FLOAT, 0.002, 0.0005, 0.005, 0.0001)
DEFINE_UI_PARAMS(full_code, Full scale code, DCTLUI_SLIDER_FLOAT, 1023.0, 255.0, 4095.0, 1.0)
DEFINE_UI_PARAMS(clamp01, Clamp output to 0 to 1, DCTLUI_CHECK_BOX, 0)

__DEVICE__ float3 mat_row(int id, int row, float3 slider)
{
    if (id == 1)
    {
        if (row == 0) return make_float3(1.6258f, -0.8166f, 0.1908f);
        if (row == 1) return make_float3(0.0f, 1.5437f, -0.5437f);
        return make_float3(0.0f, 0.0f, 1.0f);
    }
    if (id == 2)
    {
        if (row == 0) return make_float3(1.6804f, -0.8959f, 0.2154f);
        if (row == 1) return make_float3(-0.5202f, 2.2989f, -0.7787f);
        return make_float3(-0.0990f, -0.2828f, 1.3818f);
    }
    if (id == 3)
    {
        if (row == 0) return make_float3(1.6755f, -0.8978f, 0.2223f);
        if (row == 1) return make_float3(0.0000f, 1.4964f, -0.4964f);
        return make_float3(0.0000f, 0.0000f, 1.0000f);
    }
    if (id == 4)
    {
        if (row == 0) return make_float3(1.6435f, -0.8576f, 0.2141f);
        if (row == 1) return make_float3(0.0000f, 1.5310f, -0.5310f);
        return make_float3(0.0000f, 0.0000f, 1.0000f);
    }
    if (id == 5)
    {
        if (row == 0) return make_float3(1.6007f, -0.7920f, 0.1913f);
        if (row == 1) return make_float3(0.0000f, 1.5145f, -0.5145f);
        return make_float3(0.0000f, 0.0000f, 1.0000f);
    }
    if (id == 6)
    {
        if (row == 0) return make_float3(1.6505f, -0.8644f, 0.2139f);
        if (row == 1) return make_float3(0.0000f, 1.5083f, -0.5083f);
        return make_float3(0.0000f, 0.0000f, 1.0000f);
    }
    return slider;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    if (mask_on == 0 && strength == 0.0f)
    {
        return make_float3(p_R, p_G, p_B);
    }
    float k = full_code * dens_step;
    float dr = p_R * k - dmin_code * dens_step;
    float dg = p_G * k - dmin_code * dens_step;
    float db = p_B * k - dmin_code * dens_step;
    if (mask_on != 0)
    {
        dr = dr - bd_r;
        dg = dg - bd_g;
        db = db - bd_b;
    }
    float3 r0 = mat_row(mat_preset, 0, make_float3(m00, m01, m02));
    float3 r1 = mat_row(mat_preset, 1, make_float3(m10, m11, m12));
    float3 r2 = mat_row(mat_preset, 2, make_float3(m20, m21, m22));
    float s = strength;
    float nr = (1.0f - s) * dr + s * (r0.x * dr + r0.y * dg + r0.z * db);
    float ng = (1.0f - s) * dg + s * (r1.x * dr + r1.y * dg + r1.z * db);
    float nb = (1.0f - s) * db + s * (r2.x * dr + r2.y * dg + r2.z * db);
    float r = (dmin_code + nr / dens_step) / full_code;
    float g = (dmin_code + ng / dens_step) / full_code;
    float b = (dmin_code + nb / dens_step) / full_code;
    if (clamp01 != 0)
    {
        r = _fminf(_fmaxf(r, 0.0f), 1.0f);
        g = _fminf(_fmaxf(g, 0.0f), 1.0f);
        b = _fminf(_fmaxf(b, 0.0f), 1.0f);
    }
    return make_float3(r, g, b);
}
